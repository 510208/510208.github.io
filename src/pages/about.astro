---
import PageLayout from "@/layouts/PageLayout.astro";
import { Content } from "@/content/about.mdx";

import "@styles/markdown.css";
---

<PageLayout
  title="關於我"
  subtitle="正因為曾經淋過雨，才會想為他人撐一把傘"
  description="這裡是關於我的一些介紹，包含了我的背景、興趣、以及這個網站的故事。如果你想更了解我的話，可以參考看看。"
  ogImage="/assets/website_og/about_og.png"
>
  <div id="post-content" class="px-8 md:px-20 lg:px-40">
    <Content />
  </div>
</PageLayout>

<style>
  .content-text {
    margin-bottom: 1rem;
    color: oklch(70.9% 0.01 56.259);
  }

  ol li,
  ul li {
    margin-bottom: 0.5rem;
    color: oklch(70.9% 0.01 56.259);
  }

  ul li a,
  ol li a {
    color: oklch(70.9% 0.01 56.259);
  }
</style>
