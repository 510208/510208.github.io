---
import config from "@shConfig";
import { buttonVariants } from "@ui/button.tsx";
import { Mail, Info, Link } from "@lucide/astro";
import { cn } from "@/lib/utils";

import Logo from "@/assets/core/samhacker.svg";

const links = config.navBar.links;
---

<header
  class="fixed top-4.5 left-1/2 z-50 w-full max-w-[1278px] -translate-x-1/2 px-4 lg:px-0 max-height-too-small:absolute"
>
  <div
    class="absolute inset-0 -z-10 mx-8 rounded-lg bg-stone-900/10 opacity-100 backdrop-blur-[6px] xl:mx-0"
    aria-hidden="true"
  >
  </div>

  <!-- 主標頭 -->
  <nav
    class="mx-4 flex h-14 items-center justify-between rounded-lg border border-white/10 bg-neutral-900/50 px-2.5 xl:mx-0"
    transition:name="header"
  >
    <!-- Logo and Site Title -->
    <a class="flex items-center gap-2" href="/">
      <div class="h-9 w-9 overflow-hidden rounded-lg">
        <img src="/favicon.png" alt="" class="h-full w-full object-cover" />
      </div>
      <div>
        <Logo
          id="sh-header-logo"
          aria-hidden
          class="h-6 opacity-100 transition-opacity duration-100 hover:opacity-80"
        />
        <p class="sr-only">SamHacker的個人網站</p>
      </div>
    </a>

    <!-- Navigation Links -->
    <div class="flex items-center gap-2 lg:gap-4">
      <!-- Main Nav -->
      <div class="hidden items-center gap-1 pr-4 lg:flex">
        {
          links.map((link, index) => (
            <div class="flex items-center">
              <a
                href={link.href}
                class="flex h-6 items-center px-2 text-sm font-medium text-white uppercase transition-colors hover:text-white/80 lg:px-4"
                aria-label={link.alt}
              >
                {link.title}
              </a>
              {index < links.length - 1 && (
                <span class="text-sm text-neutral-400">/</span>
              )}
            </div>
          ))
        }
      </div>

      <!-- Action Buttons -->
      <div class="hidden items-center gap-2 md:flex">
        <a
          class={cn(
            buttonVariants({ variant: "ghost", size: "icon" }),
            "hidden items-center justify-center rounded-lg hover:bg-white/5 sm:flex",
          )}
          href="mailto:xux510208@gmail.com"
          aria-label="Contact"
          id="sh-header-contact_button"
        >
          <Mail size={18} />
        </a>

        <a
          class={cn(
            buttonVariants({ variant: "ghost", size: "icon" }),
            "hidden items-center justify-center rounded-lg hover:bg-white/5 sm:flex",
          )}
          href="/about"
          aria-label="Info"
          id="sh-header-info_button"
        >
          <Info size={18} />
        </a>
      </div>

      <div class="flex items-center gap-2 lg:hidden">
        <a
          class={cn(
            buttonVariants({ variant: "ghost", size: "icon" }),
            "flex items-center justify-center rounded-lg hover:bg-white/5",
          )}
          aria-label="About"
          id="sh-header-about_button"
          href="https://lib.samhacker.xyz"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="連結列表"
        >
          <Link size={18} />
          更多連結
        </a>
      </div>
    </div>
  </nav>
</header>

<script>
  import { gsap } from "gsap";
  import { DrawSVGPlugin } from "gsap/DrawSVGPlugin";

  gsap.registerPlugin(DrawSVGPlugin);

  const OVERLAP = 0.1; // 固定重疊時間

  const logoContainer = document.querySelector("#sh-header-logo");
  const paths = document.querySelectorAll("#sh-header-logo path");
  // console.log("logoContainer: ", logoContainer);

  function animateSequence(
    targetTimeline: gsap.core.Timeline,
    type: "draw" | "erase",
    timelinePosition: string | number = 0,
    speed = 700,
  ) {
    (paths as NodeListOf<SVGPathElement>).forEach((path, index) => {
      const length = DrawSVGPlugin.getLength(path);
      const pathDuration = length / speed;

      // 計算每個 path 的加入時間點
      // 每筆序列的第一個 path 使用傳入的初始位置，後續的 path 則套用重疊時間
      const pos = index === 0 ? timelinePosition : `-=${OVERLAP}`;

      if (type === "draw") {
        targetTimeline.set(path, { drawSVG: "0% 0%" }, pos);

        targetTimeline.to(
          path,
          {
            duration: pathDuration,
            drawSVG: "0% 100%",
            ease: "none",
          },
          pos,
        );
      } else {
        targetTimeline.to(
          path,
          {
            duration: pathDuration,
            drawSVG: "100% 100%",
            ease: "none",
          },
          pos,
        );
      }
    });
  }

  document.addEventListener("DOMContentLoaded", () => {
    gsap.set(paths, { drawSVG: "0% 0%" });
    const initTl = gsap.timeline();
    animateSequence(initTl, "draw", 0);

    let isAnimating = false;

    (logoContainer as HTMLElement).addEventListener("mouseenter", () => {
      // 確保進場動畫已跑完，且當前沒有正在執行的 Hover 動畫
      if (initTl.isActive() || isAnimating) return;
      isAnimating = true;

      const hoverTl = gsap.timeline({
        onComplete: () => {
          isAnimating = false;
        },
      });

      animateSequence(hoverTl, "erase", 0, 1000);
      animateSequence(hoverTl, "draw", 0.2, 1000);
    });
  });
</script>
