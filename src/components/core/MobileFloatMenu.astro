---
import config from "@shConfig";
import { Separator } from "@/components/ui/separator";
import { ChevronUp } from "@lucide/astro";

const links = config.navBar.links;

interface Props {
  /** 當前頁面路徑 */
  current: string;
}

const { current } = Astro.props;
---

<!-- 浮動選單 -->
<div
  class="sh-bg-gradient fixed bottom-0 left-0 z-50 min-h-25 w-dvw lg:hidden max-height-too-small:static max-height-too-small:min-h-0"
>
  <div
    id="sh-mobile-navbar-container"
    class="sh-bg-shadow absolute bottom-10 left-1/2 flex -translate-x-1/2 items-center justify-center gap-3 rounded-xl border border-stone-700/50 bg-stone-700/40 px-2.5 py-1 backdrop-blur max-height-too-small:static max-height-too-small:mx-auto max-height-too-small:my-4 max-height-too-small:translate-x-0"
  >
    <nav
      class="flex h-8 items-center gap-3"
      tabindex="0"
      id="sh-mobile-navbar"
      aria-label="手機版選單"
      data-state="collapsed"
    >
      {
        links.map((link) => {
          // const isActive = current === link.href;
          if (link.href === current) {
            return (
              <div
                aria-label={`目前頁面：${link.alt} (${link.title})`}
                aria-current="page"
                id="sh-mobile-navbar-active-item"
                class="active-item"
              >
                <div id="sh-active-bg" aria-hidden="true" />
                <div class="active-content-inner">
                  <link.icon
                    id="sh-active-icon"
                    size={20}
                    className="text-neutral-100"
                  />
                  <div id="sh-active-text-wrapper" aria-hidden="true">
                    <span class="active-title">{link.alt}</span>
                    <span class="active-subtitle">{link.title}</span>
                  </div>
                </div>
              </div>
            );
          } else {
            return (
              <a
                href={link.href}
                target={link.href.startsWith("http") ? "_blank" : "_self"}
                rel={
                  link.href.startsWith("http")
                    ? "noopener noreferrer"
                    : undefined
                }
                aria-label={`前往 ${link.title}`}
                class={`nav-link sh-text-white sh-text-sm sh-font-medium sh-transition-colors sh-duration-300 sh-ease-in-out hover:sh-text-primary`}
                id={`sh-mobile-navbar-${link.title.toLowerCase().replace(/\s+/g, "-")}`}
              >
                <link.icon size={20} className="text-neutral-400" />
                <p class="sr-only">{link.title}</p>
              </a>
            );
          }
        })
      }
    </nav>

    <Separator orientation="vertical" />

    <button
      id="sh-mobile-navbar-toggle-btn"
      type="button"
      aria-expanded="false"
      aria-controls="sh-active-text-wrapper"
      aria-label="展開詳細導航資訊"
    >
      <ChevronUp
        size={16}
        id="sh-mobile-navbar-chevron"
        class="text-neutral-400"
      />
    </button>
  </div>
</div>

<style>
  /* 浮動選單背景漸層 */
  .sh-bg-gradient {
    background: linear-gradient(
      180deg,
      rgba(0, 0, 0, 0) 20%,
      rgba(0, 0, 0, 0.6) 100%
    );
  }

  /* 浮動選單陰影 */
  .sh-bg-shadow {
    box-shadow: 0 4px 20px -6px rgba(255, 255, 255, 0.2);
  }

  #sh-mobile-navbar-toggle-btn {
    background: transparent;
    border: none;
    padding: 6px 0;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 4px;
  }

  .nav-link {
    padding: 4px 4px;
  }

  #sh-mobile-navbar-toggle-btn:focus-visible,
  .nav-link:focus-visible {
    outline: 2px solid #f5f5f4;
    outline-offset: 2px;
  }

  .active-item {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 7px 4px;
    border-radius: 8px;
    box-sizing: border-box;
  }
  #sh-active-bg {
    position: absolute;
    inset: 0;
    background-color: #f5f5f4;
    border-radius: 8px;
    opacity: 0;
    transform: scale(0.9);
    z-index: 1;
  }
  .active-content-inner {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 0px;
  }
  #sh-active-text-wrapper {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    width: 0;
    opacity: 0;
    overflow: hidden;
    white-space: nowrap;
  }
  .active-title {
    font-size: 14px;
    font-weight: 500;
    color: #1c1917;
    line-height: 1.2;
  }
  .active-subtitle {
    font-size: 10px;
    font-weight: 400;
    color: #44403c;
    line-height: 1;
    margin-top: 2px;
  }
</style>

<script>
  import gsap from "gsap";

  document.addEventListener("DOMContentLoaded", () => {
    const container = document.querySelector(
      "#sh-mobile-navbar-container",
    ) as HTMLElement | null;
    const toggleBtn = document.querySelector(
      "#sh-mobile-navbar-toggle-btn",
    ) as HTMLElement | null;
    const chevron = document.querySelector(
      "#sh-mobile-navbar-chevron",
    ) as HTMLElement | null;

    const activeItem = document.querySelector(
      ".active-item",
    ) as HTMLElement | null;
    const activeBg = document.querySelector(
      "#sh-active-bg",
    ) as HTMLElement | null;
    const activeIcon = document.querySelector(
      "#sh-active-icon",
    ) as HTMLElement | null;
    const textWrapper = document.querySelector(
      "#sh-active-text-wrapper",
    ) as HTMLElement | null;
    const activeContentInner = document.querySelector(
      ".active-content-inner",
    ) as HTMLElement | null;

    if (
      !container ||
      !toggleBtn ||
      !chevron ||
      !activeBg ||
      !textWrapper ||
      !activeIcon ||
      !activeItem ||
      !activeContentInner
    ) {
      console.warn("未找到核心選單元素，無法初始化導航列動畫。", {
        container: container,
        toggleBtn: toggleBtn,
        chevron: chevron,
        activeBg: activeBg,
        textWrapper: textWrapper,
        activeIcon: activeIcon,
        activeItem: activeItem,
        activeContentInner: activeContentInner,
      });
      return;
    }

    // A11y：容器本身可作為點擊觸發區
    container.setAttribute("aria-expanded", "false");

    gsap.set([container, chevron, activeBg, textWrapper, activeItem], {
      willChange: "transform, opacity, width, padding",
    });

    let isExpanded = false;
    const prefersReducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;

    const tl = gsap.timeline({ paused: true });

    tl.to(chevron, { rotate: 180, duration: 0.35, ease: "power2.inOut" }, 0)
      .to(
        activeItem,
        {
          paddingTop: 10,
          paddingBottom: 10,
          paddingLeft: 12,
          paddingRight: 12,
          duration: 0.35,
          ease: "power3.inOut",
        },
        0,
      )
      .to(
        toggleBtn,
        {
          paddingTop: 18,
          paddingBottom: 18,
          duration: 0.35,
          ease: "power3.inOut",
        },
        0,
      )
      .to(
        activeContentInner,
        { gap: 10, duration: 0.35, ease: "power3.inOut" },
        0,
      )
      .to(
        activeBg,
        { opacity: 1, scale: 1, duration: 0.35, ease: "back.out(1.2)" },
        0,
      )
      .to(activeIcon, { color: "#1c1917", duration: 0.25 }, 0)
      .to(
        textWrapper,
        { width: "auto", opacity: 1, duration: 0.35, ease: "power3.inOut" },
        0.04,
      );

    if (prefersReducedMotion) {
      tl.progress(0).pause();
    }

    const setAriaAndRadius = (expanded: boolean) => {
      container.style.borderRadius = expanded ? "16px" : "9999px";
      container.setAttribute("aria-expanded", expanded ? "true" : "false");
      toggleBtn.setAttribute("aria-expanded", expanded ? "true" : "false");
      toggleBtn.setAttribute(
        "aria-label",
        expanded ? "收合詳細導航資訊" : "展開詳細導航資訊",
      );
    };

    const toggleNavbar = () => {
      if (tl.isActive()) return;

      isExpanded = !isExpanded;
      setAriaAndRadius(isExpanded);

      if (prefersReducedMotion) {
        tl.progress(isExpanded ? 1 : 0);
        return;
      }

      isExpanded ? tl.play() : tl.reverse();
    };

    // 點擊整個膠囊觸發（排除點擊 nav-link 本身）
    container.addEventListener("click", (e) => {
      if ((e.target as HTMLElement).closest(".nav-link")) return;
      e.stopPropagation();
      toggleNavbar();
    });

    // 點擊外部收合
    document.addEventListener("click", (e) => {
      if (isExpanded && !container.contains(e.target as Node)) {
        toggleNavbar();
      }
    });

    // ESC 收合並還焦點
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && isExpanded) {
        toggleNavbar();
        toggleBtn.focus();
      }
    });
  });
</script>
