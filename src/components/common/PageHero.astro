---
const { title, subtitle } = Astro.props;
import Breadcrumbs from "../common/Breadcrumbs.astro";
---

<section
  class="page-hero gsap-reveal relative mx-6 mt-30 mb-10 w-auto md:mx-20 lg:mx-auto lg:w-full lg:max-w-4xl lg:px-6 xl:max-w-6xl"
  id="sh-hero-section"
>
  <div class="mb-2"><Breadcrumbs /></div>

  <h1 class="sr-only">{title}</h1>

  <h1 class="text-4xl font-black" aria-hidden="true" id="sh-hero-title-content">
    {title}
  </h1>
  <p class="mt-2 text-lg text-stone-400" id="sh-hero-description-content">
    {subtitle}
  </p>
</section>

<script>
  import { gsap } from "gsap";
  import SplitText from "gsap/SplitText";

  gsap.registerPlugin(SplitText);

  let splitTextInstance: SplitText | null = null;

  function initPageHeroAnimation() {
    const heroSection = document.getElementById("sh-hero-section");
    const titleEl = document.getElementById("sh-hero-title-content");
    const descEl = document.getElementById("sh-hero-description-content");

    if (!heroSection || !titleEl || !descEl) return;

    // 若先前已拆分過，先復原 DOM 結構以確保安全
    if (splitTextInstance) {
      splitTextInstance.revert();
      splitTextInstance = null;
    }

    // 拆字
    splitTextInstance = new SplitText(titleEl, { type: "chars" });
    gsap.set(splitTextInstance.chars, { autoAlpha: 0, x: 50 });
    gsap.set(descEl, { autoAlpha: 0, x: 20 });

    gsap.set(heroSection, { autoAlpha: 1 });

    // 動畫開始
    const tl = gsap.timeline({ repeat: 0 });

    tl.to(splitTextInstance.chars, {
      duration: 0.8,
      autoAlpha: 1,
      x: 0,
      ease: "power2.out",
      stagger: 0.1,
    });

    tl.to(
      descEl,
      {
        duration: 0.8,
        autoAlpha: 1,
        x: 0,
        ease: "power2.out",
      },
      "-=0.3",
    );
  }

  // 靜態載入與相容生命週期觸發
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initPageHeroAnimation);
  } else {
    initPageHeroAnimation();
  }

  // 支援 Astro 切換頁面事件
  document.addEventListener("astro:page-load", initPageHeroAnimation);
</script>

<style>
  #sh-hero-section::after {
    /* 一條與螢幕寬度等寬的邊線定位在hero-section下方 */
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 1px;
    content: "";
  }
</style>
