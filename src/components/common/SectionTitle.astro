---
interface Props {
  chinese: string;
  english: string;
  id?: string;
}

const { chinese, english, id } = Astro.props;
---

<div
  class="sh-section-title gsap-reveal relative mb-4 flex w-full items-center"
>
  <h2 class="sr-only">{chinese}</h2>

  <h2
    class="sh-title-animation flex items-center gap-4 text-3xl font-bold"
    aria-hidden="true"
    id={id}
  >
    {chinese}
    <span
      class="sh-title-decoration-animation h-[2px] w-[100px] bg-white/30"
      aria-hidden="true"></span>
  </h2>
  <span
    class="sh-title-background-animation absolute left-1/2 w-full -translate-x-1/2 justify-center overflow-hidden text-center text-4xl font-extrabold whitespace-nowrap uppercase opacity-30 select-none"
    aria-hidden="true"
  >
    {english}
  </span>
</div>

<script>
  import { gsap } from "gsap";
  import { SplitText } from "gsap/SplitText";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(SplitText, ScrollTrigger);

  function initTitleAnimations() {
    const sectionTitles = document.querySelectorAll(".sh-section-title");

    sectionTitles.forEach((sectionTitle) => {
      const titleContainer = sectionTitle.querySelector(".sh-title-animation");
      const decorationLine = sectionTitle.querySelector(
        ".sh-title-decoration-animation",
      );
      const backgroundText = sectionTitle.querySelector(
        ".sh-title-background-animation",
      );

      if (!titleContainer || !decorationLine || !backgroundText) return;

      // 1. 初始化 SplitText
      const split = new SplitText(backgroundText, { type: "chars" });

      // 2. 設置組件內部子元件的動畫起始狀態
      gsap.set(titleContainer, {
        autoAlpha: 0,
        x: -50,
      });

      gsap.set(decorationLine, {
        width: 0,
      });

      gsap.set(split.chars, {
        x: 0,
        filter: "blur(5px)",
        autoAlpha: 0.3,
      });

      // 3. 子元件初始化完成後，解鎖最外層容器 (gsap-reveal) 顯現
      gsap.set(sectionTitle, { autoAlpha: 1 });

      // 4. 建立 ScrollTrigger 時間軸動畫
      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: sectionTitle,
          start: "top 80%",
          toggleActions: "play none none reverse",
        },
      });

      // 步驟一：標題從左邊淡入
      tl.to(titleContainer, {
        duration: 0.8,
        autoAlpha: 1,
        x: 0,
        ease: "power2.out",
      });

      // 步驟二：裝飾線條延伸
      tl.to(
        decorationLine,
        {
          duration: 0.6,
          width: "100px",
          ease: "power2.out",
        },
        "-=0.2",
      );

      // 步驟三：背景文字散射與清晰化
      tl.to(
        split.chars,
        {
          duration: 1.5,
          x: (i, target) => {
            const totalChars = split.chars.length;
            const centerIndex = (totalChars - 1) / 2;
            const charOffset = i - centerIndex;
            const fontSize = parseFloat(getComputedStyle(target).fontSize);
            return charOffset * fontSize;
          },
          filter: "blur(0px)",
          autoAlpha: 0.3,
          ease: "power2.out",
          stagger: 0.08,
        },
        "-=0.3",
      );
    });
  }

  // 相容 DOM 初次載入與 Astro 切換頁面生命週期
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initTitleAnimations);
  } else {
    initTitleAnimations();
  }

  document.addEventListener("astro:page-load", initTitleAnimations);
</script>
