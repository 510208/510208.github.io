---
import { cn } from "@/lib/utils";
import { SquareArrowOutUpRight } from "@lucide/astro";

interface Props {
  href: string;
  label: string;
  target?: string;
  rel?: string;
  class?: string;
}

const {
  href,
  label,
  target = "_blank",
  rel = "noopener noreferrer",
  class: className = "",
} = Astro.props;
---

<a
  href={href}
  target={target}
  rel={rel}
  title={`${label}（另開新視窗）`}
  aria-label={`${label}（另開新視窗）`}
  class={cn(
    "group overflow-hidden hover:-translate-y-2 relative rounded-xl border border-stone-800 bg-stone-900/60 backdrop-blur-md p-6 transition-all duration-200 hover:border-stone-700 hover:bg-stone-800/50",
    className,
  )}
>
  <div
    class="flex h-full flex-col justify-between rounded-lg focus:ring-2 focus:ring-stone-500 focus:outline-none"
  >
    <div>
      {/* 標題與圖示區域 */}
      <div class="flex items-center justify-between gap-x-2">
        <h3
          class="text-2xl font-bold text-stone-100 transition-colors group-hover:text-white"
        >
          <!-- slot title -->
          <slot name="title" />
        </h3>

        <p class="sr-only">（另開新視窗）</p>

        <SquareArrowOutUpRight
          class="h-5 w-5 shrink-0 text-stone-500 transition-colors group-hover:text-stone-300"
        />
      </div>

      {/* 內文描述區域 */}
      <p
        class="mt-3 text-lg leading-relaxed font-normal text-stone-300 transition-colors group-hover:text-stone-200"
      >
        <!-- slot * -->
        <slot />
      </p>
    </div>

    <div
      class="absolute bottom-0 left-0 h-1 w-0 bg-stone-500/50 transition-all duration-200 group-hover:w-full"
    >
    </div>
  </div>
</a>
