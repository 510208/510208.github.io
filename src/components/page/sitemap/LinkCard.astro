---
import { cn } from "@/lib/utils";
import { SquareArrowOutUpRight } from "@lucide/astro";

interface Props {
  href: string;
  target?: string;
  rel?: string;
  class?: string;
}

const {
  href,
  target = "_blank",
  rel = "noopener noreferrer",
  class: className = "",
} = Astro.props;
---

<div
  class={cn(
    "group relative rounded-xl border border-neutral-800 bg-neutral-900/60 p-5 transition-all duration-300 hover:border-neutral-700 hover:bg-neutral-800/50",
    className,
  )}
>
  <a
    href={href}
    target={target}
    rel={rel}
    class="flex h-full flex-col justify-between rounded-lg focus:ring-2 focus:ring-neutral-500 focus:outline-none"
  >
    <div>
      {/* 標題與圖示區域 */}
      <div class="flex items-center justify-between gap-x-2">
        <h3
          class="text-lg font-bold text-neutral-100 transition-colors group-hover:text-white"
        >
          <slot name="title" />
        </h3>

        <SquareArrowOutUpRight
          class="h-5 w-5 shrink-0 text-neutral-400 transition-colors group-hover:text-neutral-200"
        />
      </div>

      {/* 內文描述區域 */}
      <p
        class="mt-3 text-sm leading-relaxed font-normal text-neutral-400 transition-colors group-hover:text-neutral-300"
      >
        <slot />
      </p>
    </div>
  </a>
</div>
